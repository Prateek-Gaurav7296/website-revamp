# Supabase (optional for local prototyping).
# Without these, /api/leads returns 503 and the contact form shows the email fallback.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shown to visitors as the fallback contact when lead capture is unavailable.
NEXT_PUBLIC_CONTACT_EMAIL=contact@thenextberrylabs.com
